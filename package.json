{
  "name": "nexmer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/sync-content.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/build-static.mjs",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "content:sync": "node scripts/sync-content.mjs",
    "content:watch": "node scripts/watch-content.mjs",
    "check": "node scripts/sync-content.mjs && tsc --noEmit && node --test tests/content.test.mjs tests/render.test.mjs",
    "check:dist": "node --test tests/static.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
